# Real secrets / local credentials — never commit. Sanitised *.example files and the non-secret wrangler.toml stay tracked.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example
.wrangler/
*.pem
*.key
*.p12
*.pfx

# Build / deploy output and local backups
dist/
node_modules/
backup*/
__pycache__/
*.pyc
*.log

# OS / editor noise
.DS_Store
Thumbs.db
